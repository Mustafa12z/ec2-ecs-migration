aws_region   = "eu-west-2"
project_name = "legacy-api"
environment  = "production"

# DNS / TLS  ---- REQUIRED ----
# The app will be served at domain_name; hosted_zone_name must already exist in
# Route53 (ACM validation + the alias record are created for you).
domain_name      = "app.example.com"
hosted_zone_name = "example.com"

# CI/CD OIDC ---- The GitHub OIDC provider + "<project_name>-github-actions"
# role are bootstrapped manually via the AWS CLI (see MIGRATION.md), not by
# this stack, so there's nothing to configure here.

# Compute
task_cpu      = 1024
task_memory   = 2048
desired_count = 2
min_capacity  = 2
max_capacity  = 6

# Database
db_instance_class      = "db.t3.micro"
db_multi_az            = false
db_deletion_protection = false

tags = {
  Owner       = "devops-team"
  CostCenter  = "engineering"
  Application = "legacy-api"
}
