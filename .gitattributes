# Force LF line endings for files that run/parse on the Linux EC2 instance.
# Without this, Windows checkouts (core.autocrlf=true) silently reintroduce
# CRLF, which breaks bash scripts (`$'\r': command not found`) and can trip
# up nginx/systemd config parsing.
*.sh    text eol=lf
*.conf  text eol=lf
*.service text eol=lf
Dockerfile text eol=lf

# Everything else: let git decide based on content, but never let scripts
# and unit files round-trip through CRLF again.
* text=auto
